# Frontend Vite environment. Copy this to .env.local for local development.
# Tells the React app where the FastAPI backend lives.
#
# NOTE: Only the backend URL and PUBLIC Firebase web config go here.
# The Gemini API key and Firebase service-account credentials NEVER touch
# the frontend — they live exclusively in backend/.env.

# FastAPI backend (defaults to http://localhost:8000 when unset)
VITE_API_URL=http://localhost:8000

# ---- Firebase (web app config) ------------------------------------------
# Get these from: Firebase console -> Project settings -> Your apps -> Web app
# When all required vars are set, Google Sign-In + Firestore persistence are
# enabled. Leave empty to run in local demo mode (mock workflows, no auth).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=