# Copy this file to backend/.env and fill in your real Gemini API key.
# The key is read ONLY by the backend — never expose it to the React app.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated list of allowed CORS origins.
# Defaults to http://localhost:5173,http://localhost:5174
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174