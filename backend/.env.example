# Copy this file to backend/.env and fill in your real values.
# The Gemini key is read ONLY by the backend — never expose it to the React app.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated list of allowed CORS origins.
# Defaults to http://localhost:5173,http://localhost:5174,
# http://localhost:3000 (Vite/React default + dev server)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Firebase Admin (auth + Firestore) -----------------------------------
# Point this at the service-account JSON you download from
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. NEVER commit this file. When unset, the backend runs in demo
# mode (no auth, in-memory store).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative to the above when using Application Default Credentials (e.g.
# Cloud Run / gcloud auth). Used when FIREBASE_SERVICE_ACCOUNT_PATH is unset.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Optional: only needed when using Application Default Credentials:
# FIREBASE_PROJECT_ID=<your-firebase-project-id>

# ---- Google OAuth 2.0 (Gmail / Calendar / Drive) ----------------------------
# Create OAuth 2.0 credentials in Google Cloud Console:
#   APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#   Application type: Web application
#   Authorized redirect URIs: add the value(s) of GOOGLE_OAUTH_REDIRECT_URI below
# Scopes used:
#   Gmail:    https://www.googleapis.com/auth/gmail.readonly
#   Calendar: https://www.googleapis.com/auth/calendar.readonly
#   Drive:    https://www.googleapis.com/auth/drive.readonly
# When unset, connection endpoints return 503.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Primary redirect URI. For multi-service support, register BOTH:
#   http://localhost:8010/api/auth/gmail/callback   (legacy, Gmail)
#   http://localhost:8010/api/auth/callback         (generic, Calendar/Drive)
# Or set to the generic one and register it. Current default is legacy gmail callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/api/auth/gmail/callback

# Optional: TTL for OAuth state tokens (seconds, default 600).
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# ---- YouTube Data API v3 (server-only) ------------------------------------
# Get from Google Cloud Console → APIs & Services → Credentials → Create API key
# Restrict key to: YouTube Data API v3
# NEVER put this in the frontend .env — it lives only in backend/.env
# When unset, video recommendations are silently disabled (graceful fallback).
# Enable API: YouTube Data API v3
YOUTUBE_API_KEY=

# ---- Google Maps Platform (API key, server-only) ----------------------------
# Get from Google Cloud Console → APIs & Services → Credentials → Create API key
# Restrict key to: Geocoding API, Directions API, Distance Matrix API
# NEVER put this in the frontend .env — it lives only in backend/.env
# When unset, Maps endpoints return 503 / disabled status.
# Enable APIs: Geocoding API, Directions API, Distance Matrix API
GOOGLE_MAPS_API_KEY=

# ---- Token encryption (production) ----------------------------------------
# Optional: if set, OAuth tokens are encrypted at rest with this key.
# Generate via: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Requires: pip install cryptography
# When unset, tokens are stored plaintext with encrypted:false marker (demo only).
# TOKEN_ENCRYPTION_KEY=